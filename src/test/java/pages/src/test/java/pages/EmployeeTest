package tests;

import base.BaseTest;
import org.testng.Assert;
import org.testng.annotations.Test;
import pages.DashboardPage;
import pages.EmployeeListPage;
import pages.LoginPage;

public class EmployeeTest extends BaseTest {

    /**
     * Test: Verify Employee List Page Loads
     */
    @Test(groups = {"smoke", "regression"}, description = "Verify employee list page loads")
    public void verifyEmployeeListLoads() {
        LoginPage loginPage = new LoginPage(driver);
        loginPage.login("Admin", "admin123");

        try {
            Thread.sleep(2000);
        } catch (InterruptedException e) {
            e.printStackTrace();
        }

        DashboardPage dashboardPage = new DashboardPage(driver);
        Assert.assertTrue(dashboardPage.isDashboardLoaded(), "Dashboard not loaded");

        dashboardPage.clickPIMMenu();

        try {
            Thread.sleep(2000);
        } catch (InterruptedException e) {
            e.printStackTrace();
        }

        EmployeeListPage employeeListPage = new EmployeeListPage(driver);
        Assert.assertTrue(employeeListPage.isEmployeeListLoaded(), "Employee list page not loaded");
    }

    /**
     * Test: Verify Employee Table is Displayed
     */
    @Test(groups = {"regression"}, description = "Verify employee table displays data")
    public void verifyEmployeeTableDisplayed() {
        LoginPage loginPage = new LoginPage(driver);
        loginPage.login("Admin", "admin123");

        try {
            Thread.sleep(2000);
        } catch (InterruptedException e) {
            e.printStackTrace();
        }

        DashboardPage dashboardPage = new DashboardPage(driver);
        dashboardPage.clickPIMMenu();

        try {
            Thread.sleep(2000);
        } catch (InterruptedException e) {
            e.printStackTrace();
        }

        EmployeeListPage employeeListPage = new EmployeeListPage(driver);
        Assert.assertTrue(employeeListPage.isEmployeeTableDisplayed(), "Employee table not displayed");
    }

    /**
     * Test: Verify Employee Count
     */
    @Test(groups = {"regression"}, description = "Verify employee count in list")
    public void verifyEmployeeCount() {
        LoginPage loginPage = new LoginPage(driver);
        loginPage.login("Admin", "admin123");

        try {
            Thread.sleep(2000);
        } catch (InterruptedException e) {
            e.printStackTrace();
        }

        DashboardPage dashboardPage = new DashboardPage(driver);
        dashboardPage.clickPIMMenu();

        try {
            Thread.sleep(2000);
        } catch (InterruptedException e) {
            e.printStackTrace();
        }

        EmployeeListPage employeeListPage = new EmployeeListPage(driver);
        int employeeCount = employeeListPage.getEmployeeCount();
        Assert.assertTrue(employeeCount > 0, "No employees found in list");
        System.out.println("Number of employees: " + employeeCount);
    }

    /**
     * Test: Verify Search Employee Functionality
     */
    @Test(groups = {"regression"}, description = "Verify employee search functionality")
    public void verifySearchEmployee() {
        LoginPage loginPage = new LoginPage(driver);
        loginPage.login("Admin", "admin123");

        try {
            Thread.sleep(2000);
        } catch (InterruptedException e) {
            e.printStackTrace();
        }

        DashboardPage dashboardPage = new DashboardPage(driver);
        dashboardPage.clickPIMMenu();

        try {
            Thread.sleep(2000);
        } catch (InterruptedException e) {
            e.printStackTrace();
        }

        EmployeeListPage employeeListPage = new EmployeeListPage(driver);
        Assert.assertTrue(employeeListPage.isEmployeeListLoaded(), "Employee list not loaded");

        // Search for an employee
        employeeListPage.searchEmployee("Ashlee");

        try {
            Thread.sleep(2000);
        } catch (InterruptedException e) {
            e.printStackTrace();
        }

        int resultCount = employeeListPage.getEmployeeCount();
        Assert.assertTrue(resultCount > 0, "No search results found");
        System.out.println("Search results found: " + resultCount);
    }

    /**
     * Test: Verify First Employee Details
     */
    @Test(groups = {"regression"}, description = "Verify first employee details in list")
    public void verifyFirstEmployeeDetails() {
        LoginPage loginPage = new LoginPage(driver);
        loginPage.login("Admin", "admin123");

        try {
