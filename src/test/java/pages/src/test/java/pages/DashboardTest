package tests;

import base.BaseTest;
import org.openqa.selenium.support.ui.ExpectedConditions;
import org.testng.Assert;
import org.testng.annotations.Test;
import pages.DashboardPage;
import pages.LoginPage;

public class DashboardTest extends BaseTest {

    /**
     * Test: Verify Dashboard Page Loads Successfully
     */
    @Test(groups = {"smoke", "regression"}, description = "Verify dashboard loads after successful login")
    public void verifyDashboardLoads() {
        LoginPage loginPage = new LoginPage(driver);
        loginPage.login("Admin", "admin123");

        // ✅ Replace Thread.sleep(2000) with explicit wait
        wait.until(ExpectedConditions.titleContains("OrangeHRM"));

        DashboardPage dashboardPage = new DashboardPage(driver);
        Assert.assertTrue(dashboardPage.isDashboardLoaded(), "Dashboard page did not load");
        Assert.assertEquals(dashboardPage.getDashboardTitle(), "Dashboard");
    }

    /**
     * Test: Verify Navigation Menu is Visible
     */
    @Test(groups = {"smoke", "regression"}, description = "Verify navigation menu is visible on dashboard")
    public void verifyNavigationMenuVisible() {
        LoginPage loginPage = new LoginPage(driver);
        loginPage.login("Admin", "admin123");

        // ✅ Wait for URL to contain 'dashboard' instead of sleep
        wait.until(ExpectedConditions.urlContains("dashboard"));

        DashboardPage dashboardPage = new DashboardPage(driver);
        Assert.assertTrue(dashboardPage.isNavigationMenuVisible(), "Navigation menu is not visible");
    }

    /**
     * Test: Verify Dashboard Contains Widgets
     */
    @Test(groups = {"regression"}, description = "Verify dashboard displays widgets")
    public void verifyDashboardWidgets() {
        LoginPage loginPage = new LoginPage(driver);
        loginPage.login("Admin", "admin123");

        wait.until(ExpectedConditions.urlContains("dashboard"));

        DashboardPage dashboardPage = new DashboardPage(driver);
        int widgetCount = dashboardPage.getDashboardWidgetCount();
        Assert.assertTrue(widgetCount > 0, "No widgets found on dashboard");
        System.out.println("Number of widgets on dashboard: " + widgetCount);
    }

    /**
     * Test: Verify Admin Menu Link is Accessible
     */
    @Test(groups = {"regression"}, description = "Verify Admin menu navigation")
    public void verifyAdminMenuNavigation() {
        LoginPage loginPage = new LoginPage(driver);
        loginPage.login("Admin", "admin123");

        wait.until(ExpectedConditions.urlContains("dashboard"));

        DashboardPage dashboardPage = new DashboardPage(driver);
        Assert.assertTrue(dashboardPage.isDashboardLoaded(), "Dashboard did not load");

        dashboardPage.clickAdminMenu();
        
        // ✅ Wait for page to load after navigation
        wait.until(ExpectedConditions.urlContains("admin"));
        
        String pageTitle = driver.getTitle();
        Assert.assertTrue(pageTitle.contains("OrangeHRM"), "Admin page did not load");
    }

    /**
     * Test: Verify Logout Functionality
     */
    @Test(groups = {"smoke", "regression"}, description = "Verify logout functionality")
    public void verifyLogout() {
        LoginPage loginPage = new LoginPage(driver);
        loginPage.login("Admin", "admin123");

        wait.until(ExpectedConditions.urlContains("dashboard"));

        DashboardPage dashboardPage = new DashboardPage(driver);
        Assert.assertTrue(dashboardPage.isDashboardLoaded(), "Dashboard did not load");

        dashboardPage.logout();
        
        // ✅ Wait for login page URL after logout
        wait.until(ExpectedConditions.urlContains("login"));
        
        String currentUrl = driver.getCurrentUrl();
        Assert.assertTrue(currentUrl.contains("login"), "User not logged out properly");
    }
}
